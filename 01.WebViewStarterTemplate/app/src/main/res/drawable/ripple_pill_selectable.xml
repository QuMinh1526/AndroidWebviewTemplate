<?xml version="1.0" encoding="utf-8"?>
<!-- Pill button tự đổi trạng thái theo isSelected (Desktop ON / Audio running) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true" android:drawable="@drawable/bg_pill_button_active" />
            <item android:drawable="@drawable/bg_pill_button" />
        </selector>
    </item>
</ripple>
