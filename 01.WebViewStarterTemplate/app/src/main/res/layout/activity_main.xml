<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D11"
    android:orientation="vertical">

    <!-- ===== Row 1: navigation + URL + GO + Settings ===== -->
    <LinearLayout
        android:id="@+id/toolbar_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btn_back"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/ripple_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="&lt;"
            android:textColor="#F2F2F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_forward"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/ripple_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="&gt;"
            android:textColor="#F2F2F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_url_input"
            android:hint="Enter URL or search"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#F2F2F7"
            android:textColorHint="#6B6B76"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_go"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/ripple_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="GO"
            android:textColor="#F2F2F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ripple_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Settings"
            android:textColor="#F2F2F7"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== Row 2: secondary tools (compact) ===== -->
    <LinearLayout
        android:id="@+id/toolbar_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_desktop_site"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/ripple_pill_selectable"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Desktop: OFF"
            android:textColor="#F2F2F7"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_audio_panel_toggle"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ripple_pill_selectable"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Audio +"
            android:textColor="#F2F2F7"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_audio"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ripple_pill_selectable"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Start audio"
            android:textColor="#F2F2F7"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/audio_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Audio idle"
            android:textColor="#9A9AA5"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== Audio device pickers (toggle via Audio +/-) ===== -->
    <LinearLayout
        android:id="@+id/audio_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mic"
            android:textColor="#9A9AA5"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/input_device_spinner"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:text="Out"
            android:textColor="#9A9AA5"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/output_device_spinner"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ===== Page progress ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/page_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="0%"
            android:textColor="#9A9AA5"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
