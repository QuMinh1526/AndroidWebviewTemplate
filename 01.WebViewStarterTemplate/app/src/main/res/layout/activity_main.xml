<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D11"
    android:orientation="vertical">

    <!--
      ===== Topbar duy nhất: [ < ] [ > ] [ URL ] [ GO ] [ ⚙ ] =====
      Nền kính mờ #1A1A1E (~85%), viền #2E2E38, bo góc 14dp (bg_glass_panel).
      Toàn bộ công tắc Desktop / Audio / Shizuku đã chuyển vào BottomSheet Settings
      để nhường tối đa diện tích cho WebView.
    -->
    <LinearLayout
        android:id="@+id/toolbar_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_back"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/ripple_pill"
            android:contentDescription="@string/nav_back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="&lt;"
            android:textColor="#F2F2F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_forward"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ripple_pill"
            android:contentDescription="@string/nav_forward"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="&gt;"
            android:textColor="#F2F2F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_url_input"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#F2F2F7"
            android:textColorHint="#6B6B76"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_go"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/ripple_pill"
            android:contentDescription="@string/nav_go"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/nav_go"
            android:textColor="#F2F2F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/ripple_pill"
            android:contentDescription="@string/settings_title"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="&#9881;"
            android:textColor="#F2F2F7"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ===== Page progress ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/page_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/progress_zero"
            android:textColor="#9A9AA5"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
